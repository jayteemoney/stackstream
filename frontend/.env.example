# Copy to .env.local to override the defaults for `npm run dev`.
#
# With no env file the app runs against the live mainnet deployment, the same
# contracts as stackstream.xyz. Real wallets and real funds: test with small
# amounts.
#
# The network and the deployer are a pair. A mismatched pair (a testnet network
# with a mainnet SP… deployer, or the reverse) stops the app at startup.

# mainnet (default) or testnet
NEXT_PUBLIC_NETWORK=mainnet
# The address that deployed stream-manager and stream-factory on that network
NEXT_PUBLIC_CONTRACT_DEPLOYER=SP2V6TCRFTYQHP8F4D9HSFZHRQNGVBQEZR0TMSM79

# For a testnet build, replace both lines above with your testnet deployment:
# NEXT_PUBLIC_NETWORK=testnet
# NEXT_PUBLIC_CONTRACT_DEPLOYER=ST…your-testnet-deployer
